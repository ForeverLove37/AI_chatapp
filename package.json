{
  "name": "adaptive-chat-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch services/api/src/index.ts",
    "dev:api:real": "DEMO_MODE=false node --env-file-if-exists=.env --import tsx --watch services/api/src/index.ts",
    "dev:admin": "node scripts/dev-admin.mjs",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
