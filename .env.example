API_PORT=8787
DEMO_MODE=false
ADMIN_API_KEY=replace-with-a-long-random-admin-secret
UPSTREAM_KEY_ENCRYPTION_SECRET=replace-with-a-separate-long-random-encryption-secret
AUTH_TOKEN_SECRET=replace-with-a-separate-long-random-session-secret
AUTH_TOKEN_TTL_SECONDS=604800
REQUIRE_CLIENT_AUTH=true
DEMO_STREAM_DELAY_MS=12
# Optional but recommended for expiry/security notices. Deployment falls back to Certbot's explicit no-email mode when unset.
CERTBOT_EMAIL=
CORS_ORIGINS=https://console.zengjunjie.com,https://chatapi.zengjunjie.com,https://chat.zengjunjie.com
PUBLIC_API_BASE_URL=https://chatapi.zengjunjie.com
AVATAR_STORAGE_DIR=/avatars

# Upstream provider credentials are intentionally absent. Add them only through
# the Admin Console, where they are encrypted before PostgreSQL persistence.

# Runtime service and persistence settings.
BACKEND_URL=http://localhost:8787
POSTGRES_DB=adaptive_chat
POSTGRES_USER=adaptive_chat
POSTGRES_PASSWORD=adaptive_chat
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://adaptive_chat:adaptive_chat@postgres:5432/adaptive_chat
