API_PORT=8787
DEMO_MODE=false
ADMIN_API_KEY=replace-with-a-long-random-admin-secret
UPSTREAM_KEY_ENCRYPTION_SECRET=replace-with-a-separate-long-random-encryption-secret
REQUIRE_CLIENT_AUTH=false
DEMO_STREAM_DELAY_MS=12
# Optional but recommended for expiry/security notices. Deployment falls back to Certbot's explicit no-email mode when unset.
CERTBOT_EMAIL=
CORS_ORIGINS=https://console.zengjunjie.com

# A generic OpenAI-compatible provider. These values are loaded by Docker Compose and never sent to Android clients.
URL=https://api.example.com/v1
KEY=

# OpenAI-compatible upstream endpoints. Leave unset while using DEMO_MODE.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# The Next.js server reads these values when proxying its admin API routes.
BACKEND_URL=http://localhost:8787
POSTGRES_DB=adaptive_chat
POSTGRES_USER=adaptive_chat
POSTGRES_PASSWORD=adaptive_chat
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://adaptive_chat:adaptive_chat@postgres:5432/adaptive_chat
